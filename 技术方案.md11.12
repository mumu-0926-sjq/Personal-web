### ③ 一段能直接跑通的验证脚本

保存为 `C:\Users\mac\Desktop\verify_stage0.py`（已落盘，内容与下方一致），运行 `python verify_stage0.py`：

```python
# -*- coding: utf-8 -*-
# 声明源码编码为 UTF-8，保证 Windows 下中文注释与中文输出不乱码。
"""阶段 0 自测脚本 v1.0：校验科研采购与供应商交付技术方案、两套知识库语料、国内模型配置与统一响应契约。

入参：无（命令行直接运行；基准目录取脚本所在目录）。
出参：无返回值；标准输出一条统一结构的 JSON 结果。
失败时的行为：任一检查未通过即打印 ok=false 的失败响应并以退出码 1 结束，不输出半成品结论。
"""
import json  # 导入标准库 json，用于解析 JSONL 语料并序列化统一响应。
import sys  # 导入标准库 sys，用于校验失败时以非零退出码结束进程。
from pathlib import Path  # 导入 Path，用于以跨平台绝对路径定位交付文件。

BASE_DIR = Path(__file__).resolve().parent  # 取脚本所在目录为基准，避免依赖当前工作目录。
PLAN_FILE = BASE_DIR / "技术方案.md"  # 技术方案主交付物的绝对路径。
PROMPT_FILE = BASE_DIR / "技术方案提示词.md"  # 独立提示词交付物的绝对路径。
KB_FILES = {  # 两套知识库语料文件路径表，严格两套，不增第三套。
    "kb_daily_dev": BASE_DIR / "kb" / "daily_dev" / "corpus.jsonl",  # KB-1 @scene#54「日常开发」工程规范库。
    "kb_business": BASE_DIR / "kb" / "business" / "corpus.jsonl",  # KB-2 科研采购业务事实库。
}  # 路径表定义结束。
SECTION_KEYS = ("技术方案提示词", "项目理解", "输入材料", "业务域更正", "技术栈", "模型选型", "两套知识库", "现状流程与异常路径", "三道卡", "config.yaml", "阶段 0 交付")  # 方案必须覆盖的章节关键词。
RULE_KEYS = ("中文 docstring", "行内注释", "每行代码", "统一响应", "变更文件清单", "启动与自测命令", "验证脚本", "最可能出问题", "人工确认", "status=unverified", "审计六要素", "证据强度", "allow_overseas", "MODEL_UNAVAILABLE", "四来源")  # 提示词必须锁定的约束关键词。
ERROR_CODES = ("SECURITY_BLOCK", "PERMISSION_DENIED", "NEED_HUMAN_CONFIRM", "STALE_SNAPSHOT", "EVIDENCE_CONFLICT", "KB_NOT_FOUND", "MODEL_UNAVAILABLE")  # 方案必须声明的对外错误码。
MUST_EVIDENCE = ("research-procurement-f00", "research-procurement-f05", "research-procurement-f11", "research-procurement-f15", "research-procurement-f23", "research-procurement-f24", "research-procurement-f30", "research-procurement-f31", "research-procurement-f33", "research-procurement-f34", "research-procurement-f35", "research-procurement-f40", "research-procurement-f41", "research-procurement-f42", "research-procurement-f44", "research-procurement-f45", "research-procurement-f52", "research-procurement-f53", "research-procurement-f55")  # 语料必须覆盖的关键事实编号。
DOC_FIELDS = ("doc_id", "namespace", "source_id", "evidence_ids", "version", "status", "permission_tag", "freshness", "text")  # 每篇语料文档的必需字段。
NAMESPACES = {"engineering", "research_procurement"}  # 两套库内允许的命名空间，业务域只有一个。
RESPONSE_KEYS = {"ok", "data", "error"}  # 统一响应的固定键集合，任何分支不得增删。
DOMAIN_NAME = "科研采购与供应商交付"  # 本项目的唯一业务域名称。
MIN_DOCS = {"kb_daily_dev": 8, "kb_business": 60}  # 两套知识库语料篇数下限，防止材料没被真正装载。
DOMESTIC_PROVIDERS = ("aliyun-bailian", "zhipu-bigmodel")  # 允许出现的国内服务商白名单。
DOMESTIC_MODELS = ("qwen-plus", "glm-4-flash")  # 允许作为主备的国内免费模型白名单。
OVERSEAS_MODELS = ("Gemini", "GPT-", "Claude", "provider: google", "provider: openai")  # config 块内禁止出现的境外模型与服务商痕迹。


def build_response(ok, data=None, error=None):  # 定义统一响应构造器，所有对外接口共用它以保证结构恒定。
    """构造统一响应结构。

    入参：ok（bool，是否成功）、data（任意，成功时的业务数据）、error（dict 或 None，失败时的错误对象）。
    出参：dict，恒含 ok / data / error 三个键。
    失败时的行为：ok 不是 bool、或失败分支的 error 不是含 code 与 msg 的 dict 时抛出 ValueError 并终止，绝不返回结构不完整的响应。
    """  # 函数级中文 docstring，写明入参、出参和失败时的行为。
    if not isinstance(ok, bool):  # 校验 ok 的类型，防止把字符串误当成布尔值。
        raise ValueError("ok 必须是 bool")  # 类型不符即抛异常，不让脏数据流入对外接口。
    if not ok and not (isinstance(error, dict) and "code" in error and "msg" in error):  # 校验失败分支的 error 结构完整性。
        raise ValueError("失败时 error 必须含 code 与 msg")  # 结构不完整即抛异常，避免前端拿到无法解析的错误。
    return {"ok": ok, "data": data, "error": error}  # 返回键集合恒定的统一响应对象。


def safe_print(text):  # 定义安全打印函数，兼容 Windows 非 UTF-8 控制台。
    """把文本打印到标准输出。

    入参：text（str，待输出文本）。
    出参：无返回值。
    失败时的行为：控制台编码不支持中文时退化为反斜杠转义输出，不抛异常、不中断自测。
    """  # 函数级中文 docstring，写明入参、出参和失败时的行为。
    try:  # 先尝试按控制台默认编码直接输出中文。
        print(text)  # 输出原始文本，保持可读性。
    except UnicodeEncodeError:  # 捕获中文编码失败，说明控制台不是 UTF-8。
        print(text.encode("ascii", "backslashreplace").decode("ascii"))  # 退化为转义序列输出，保证脚本仍能跑通。


def load_kb():  # 定义语料加载函数，逐行解析两套知识库的 JSONL 文档。
    """加载并校验两套知识库语料。

    入参：无（读取模块级 KB_FILES / DOC_FIELDS / NAMESPACES / MIN_DOCS）。
    出参：tuple[list[dict], list[str]]，分别为文档列表与问题列表。
    失败时的行为：文件缺失、单行 JSON 非法、字段缺失、命名空间越界或篇数不足时记录为问题并继续检查，不抛异常。
    """  # 函数级中文 docstring，写明入参、出参和失败时的行为。
    docs = []  # 初始化文档列表，用于汇总两套库的全部语料。
    problems = []  # 初始化问题列表，用于累积语料层的所有缺陷。
    for kb_id, path in KB_FILES.items():  # 遍历两套知识库的编号与路径。
        if not path.is_file():  # 判断语料文件是否真实存在。
            problems.append(f"缺少知识库语料：{kb_id}")  # 缺文件时记录明确说明并跳过该库。
            continue  # 继续检查下一套库，不中断整体自测。
        count = 0  # 初始化该库的有效文档计数。
        for lineno, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):  # 以 UTF-8 逐行读取并保留行号。
            if not line.strip():  # 判断该行是否为空白行。
                continue  # 空行不产生文档，直接跳过。
            try:  # 保护单行 JSON 解析，避免一处坏行中断全量校验。
                doc = json.loads(line)  # 把一行 JSON 解析为一个语料文档。
            except json.JSONDecodeError as exc:  # 捕获非法 JSON 异常。
                problems.append(f"{kb_id} 第 {lineno} 行 JSON 非法：{exc}")  # 记录库名、行号与具体原因。
                continue  # 跳过坏行，继续检查后续行。
            count += 1  # 有效行计数加一，用于篇数下限校验。
            missing = [k for k in DOC_FIELDS if k not in doc]  # 计算该文档缺失的必需字段。
            if missing:  # 判断是否存在缺字段。
                problems.append(f"{kb_id} 第 {lineno} 行缺字段：{','.join(missing)}")  # 记录缺失字段清单。
            if doc.get("namespace") not in NAMESPACES:  # 校验命名空间是否在允许集合内。
                problems.append(f"{kb_id} 第 {lineno} 行命名空间越界：{doc.get('namespace')}")  # 记录越界问题，防止混入科创模板域。
            if kb_id == "kb_business" and doc.get("status") != "unverified":  # 业务语料一律必须是未核实状态。
                problems.append(f"{kb_id} 第 {lineno} 行未标注 status=unverified")  # 记录证据强度标注缺失，防止口述被当事实。
            docs.append(doc)  # 把文档加入结果列表，供后续证据覆盖检查使用。
        if count < MIN_DOCS[kb_id]:  # 判断该库装载篇数是否达到下限。
            problems.append(f"{kb_id} 语料仅 {count} 篇，少于 {MIN_DOCS[kb_id]} 篇")  # 记录篇数不足，说明材料没被完整装载。
    return docs, problems  # 返回文档列表与问题列表。


def check_plan(docs):  # 定义方案检查函数，校验章节、约束、错误码、业务域与证据覆盖。
    """检查技术方案是否覆盖全部必需内容，并核对业务域口径与语料证据编号。

    入参：docs（list[dict]，load_kb 返回的语料文档列表）。
    出参：list[str]，缺失项说明；空列表表示通过。
    失败时的行为：方案文件不存在时返回单条说明，不抛异常，由 main 统一汇总为失败响应。
    """  # 函数级中文 docstring，写明入参、出参和失败时的行为。
    if not PLAN_FILE.is_file():  # 判断技术方案文件是否真实存在。
        return [f"缺少交付文件：{PLAN_FILE.name}"]  # 文件缺失时返回明确说明。
    text = PLAN_FILE.read_text(encoding="utf-8")  # 以 UTF-8 读取方案全文，避免 Windows 默认编码解码失败。
    missing = [f"缺少章节：{k}" for k in SECTION_KEYS if k not in text]  # 逐条比对必需章节关键词。
    missing += [f"缺少约束：{k}" for k in RULE_KEYS if k not in text]  # 逐条比对必需约束关键词。
    missing += [f"缺少错误码：{c}" for c in ERROR_CODES if c not in text]  # 逐条比对对外错误码声明。
    if DOMAIN_NAME not in text:  # 校验方案是否锚定正确的业务域。
        missing.append("方案未锚定科研采购与供应商交付业务域")  # 业务域缺失即判定主次颠倒。
    body = text.split("```python")[0]  # 剔除方案末尾内嵌的验证脚本，避免把脚本里的禁词字面量当成方案正文残留。
    if "teen_innovation" in body:  # 校验方案正文是否残留科创咨询命名空间。
        missing.append("方案正文仍残留科创咨询命名空间")  # 残留即判定模板被误当业务域。
    if "模板范式" not in text:  # 校验是否明确声明科创只是参考模板。
        missing.append("方案未声明科创咨询仅作模板范式参考")  # 缺声明即无法防止本末倒置。
    evidence = {e for d in docs for e in d.get("evidence_ids", [])}  # 汇总语料中出现的全部事实引用编号。
    missing += [f"语料缺少证据：{e}" for e in MUST_EVIDENCE if e not in evidence]  # 检查关键证据是否被语料覆盖。
    return missing  # 返回全部缺失项；为空代表方案与语料完整。


def check_models():  # 定义模型配置检查函数，校验主备模型全部国产化且配置不落密钥。
    """校验 config.yaml 键位片段中的模型选型、降级开关与密钥约束。

    入参：无（读取模块级 PLAN_FILE / DOMESTIC_PROVIDERS / DOMESTIC_MODELS / OVERSEAS_MODELS）。
    出参：list[str]，模型配置违规说明；空列表表示通过。
    失败时的行为：方案文件缺失或找不到 config 代码块时返回单条说明，不抛异常。
    """  # 函数级中文 docstring，写明入参、出参和失败时的行为。
    if not PLAN_FILE.is_file():  # 判断技术方案文件是否真实存在。
        return [f"缺少交付文件：{PLAN_FILE.name}"]  # 文件缺失时返回明确说明。
    text = PLAN_FILE.read_text(encoding="utf-8")  # 以 UTF-8 读取方案全文。
    start = text.find("models:")  # 定位 config.yaml 代码块中 models 段的起点。
    end = text.find("knowledge_bases:", start)  # 定位 models 段的终点，限定检查范围不误伤正文表格。
    if start < 0 or end < 0:  # 判断 models 配置块是否完整存在。
        return ["方案缺少 config.yaml 的 models 配置块"]  # 缺块即无法校验模型国产化。
    block = text[start:end]  # 截取 models 配置片段，只在该片段内做白名单与黑名单检查。
    problems = []  # 初始化违规列表，累积所有发现的问题。
    if "allow_overseas: false" not in block:  # 校验是否硬开关禁止境外模型。
        problems.append("缺少 allow_overseas: false 硬开关")  # 缺开关即无法保证数据不出境。
    for provider in DOMESTIC_PROVIDERS:  # 遍历允许出现的国内服务商白名单。
        if f"provider: {provider}" not in block:  # 判断主备配置是否都落在国内服务商。
            problems.append(f"config 缺少国内服务商：{provider}")  # 缺服务商即判定主备未全国产化。
    for name in DOMESTIC_MODELS:  # 遍历允许的国内免费模型名。
        if f"name: {name}" not in block:  # 判断主备模型名是否落在白名单内。
            problems.append(f"config 缺少国内免费模型：{name}")  # 缺模型名即判定选型未落地。
    for bad in OVERSEAS_MODELS:  # 遍历境外模型与服务商黑名单。
        if bad in block:  # 判断 config 片段内是否残留境外痕迹。
            problems.append(f"config 残留境外模型或服务商：{bad}")  # 残留即违反国内模型约束。
    if "sk-" in block:  # 判断 config 片段内是否出现疑似真实密钥字面量。
        problems.append("config 出现疑似密钥字面量")  # 出现即违反密钥只记环境变量名的约束。
    if block.count("api_key_env:") < 2:  # 校验主备两条是否都只记录环境变量名。
        problems.append("主备模型未都使用 api_key_env 记录环境变量名")  # 少于两条即判定密钥配置不全。
    if "forbid_silent_fallback: true" not in block:  # 校验是否禁止静默降级。
        problems.append("缺少 forbid_silent_fallback: true")  # 缺开关即可能让模型编造事实填空。
    if "MODEL_UNAVAILABLE" not in text:  # 校验方案是否声明双模型失败后的错误码。
        problems.append("方案未声明 MODEL_UNAVAILABLE 降级终态")  # 缺终态即无法转人工。
    return problems  # 返回全部违规项；为空代表模型配置通过。


def check_prompt(plan_text):  # 定义提示词检查函数，校验独立交付物与方案内嵌副本一致且业务域正确。
    """校验独立提示词文件的业务域、模板限定、纯正文格式与方案内嵌一致性。

    入参：plan_text（str，技术方案全文，用于比对内嵌副本）。
    出参：list[str]，提示词违规说明；空列表表示通过。
    失败时的行为：文件不存在时返回单条说明，不抛异常，由 main 统一汇总为失败响应。
    """  # 函数级中文 docstring，写明入参、出参和失败时的行为。
    if not PROMPT_FILE.is_file():  # 判断独立提示词文件是否真实存在。
        return [f"缺少交付文件：{PROMPT_FILE.name}"]  # 文件缺失时返回明确说明。
    text = PROMPT_FILE.read_text(encoding="utf-8")  # 以 UTF-8 读取独立提示词全文。
    problems = []  # 初始化违规列表，累积所有发现的问题。
    lines = text.splitlines()  # 按行切分，便于精确检查首句业务域。
    first = lines[0] if lines else ""  # 取首句作为系统目标声明。
    if DOMAIN_NAME not in first:  # 校验首句是否锚定科研采购业务域。
        problems.append("提示词首句未锚定科研采购与供应商交付")  # 首句错即判定主次颠倒。
    if "青少年科创咨询智能体系统" in first:  # 校验首句是否误把模板当系统目标。
        problems.append("提示词首句仍把科创模板当系统目标")  # 首句残留即判定业务域错误。
    if "模板范式" not in text:  # 校验是否明确限定科创模板的用途。
        problems.append("提示词未声明科创模板仅作结构范式参考")  # 缺声明即无法防止语料污染。
    if "teen_innovation" in text:  # 校验提示词是否残留科创命名空间。
        problems.append("提示词残留 teen_innovation 命名空间")  # 残留即判定存在第二业务域。
    if "```" in text:  # 校验独立提示词是否为可直接复制的纯正文。
        problems.append("独立提示词含代码块围栏，不便直接提交")  # 含围栏即不符合纯正文交付要求。
    for name in ("Qwen", "GLM-4-Flash"):  # 遍历提示词必须点名的国内免费模型。
        if name not in text:  # 判断是否明确写出国内模型选型。
            problems.append(f"提示词未锁定国内免费模型：{name}")  # 缺选型即无法保证国产化。
    if text.strip() not in plan_text:  # 校验方案第一节是否内嵌同一份提示词全文。
        problems.append("方案第一节未内嵌与独立文件完全一致的提示词")  # 不一致即判定两份交付物脱节。
    return problems  # 返回全部违规项；为空代表提示词通过。


def check_contract():  # 定义契约检查函数，校验成功、失败、转人工三种响应分支。
    """校验统一响应结构的键集合与 JSON 可序列化性。

    入参：无。
    出参：list[str]，契约违规说明；空列表表示通过。
    失败时的行为：构造器抛 ValueError 或序列化失败时把异常文本作为一条违规返回，不中断自测。
    """  # 函数级中文 docstring，写明入参、出参和失败时的行为。
    problems = []  # 初始化违规列表，累积所有发现的问题。
    try:  # 把三种分支的构造与序列化放在同一个保护块内。
        branches = (  # 定义待校验的三种响应分支。
            build_response(True, data={"stage": 0}),  # 成功分支：error 应为 None。
            build_response(False, error={"code": "PLAN_INCOMPLETE", "msg": "方案缺项"}),  # 通用失败分支：data 应为 None。
            build_response(False, error={"code": "NEED_HUMAN_CONFIRM", "msg": "温控记录缺失，转人工"}),  # 转人工分支：必须带明确错误码。
        )  # 分支元组定义结束。
        for resp in branches:  # 遍历三种分支，逐个校验键集合与序列化能力。
            if set(resp.keys()) != RESPONSE_KEYS:  # 比对键集合是否与约定完全一致。
                problems.append("响应键集合不是 ok/data/error")  # 键不一致时记录违规。
            json.dumps(resp, ensure_ascii=False)  # 触发一次序列化，确保响应可被 HTTP 层直接返回。
    except (ValueError, TypeError) as exc:  # 捕获构造器与序列化抛出的可预期异常。
        problems.append(f"响应契约异常：{exc}")  # 把异常文本记为一条违规，不吞掉信息。
    return problems  # 返回全部违规项；为空代表契约通过。


def main():  # 定义自测入口，汇总语料、方案、模型、提示词、契约五层检查并输出统一响应。
    """执行阶段 0 自测并打印结论。

    入参：无。
    出参：无返回值；标准输出一条统一结构的 JSON。
    失败时的行为：存在任一缺失或违规时打印 ok=false、error.code=STAGE0_CHECK_FAILED 并以退出码 1 结束。
    """  # 函数级中文 docstring，写明入参、出参和失败时的行为。
    plan_text = PLAN_FILE.read_text(encoding="utf-8") if PLAN_FILE.is_file() else ""  # 预读方案全文，供提示词一致性比对。
    docs, kb_problems = load_kb()  # 先加载两套知识库语料，取得文档与语料层问题。
    problems = kb_problems + check_plan(docs) + check_models() + check_prompt(plan_text) + check_contract()  # 汇总五层全部问题。
    if problems:  # 判断是否存在问题，决定输出成功还是失败分支。
        resp = build_response(False, error={"code": "STAGE0_CHECK_FAILED", "msg": "；".join(problems)})  # 构造带具体缺失项的失败响应。
        safe_print(json.dumps(resp, ensure_ascii=False, indent=2))  # 打印失败响应，便于直接定位问题。
        sys.exit(1)  # 以非零退出码结束，便于命令行或 CI 判断自测未通过。
    checks = len(SECTION_KEYS) + len(RULE_KEYS) + len(ERROR_CODES) + len(MUST_EVIDENCE) + len(DOMESTIC_PROVIDERS) + len(DOMESTIC_MODELS) + 3  # 统计章节、约束、错误码、证据、模型与三分支的检查项规模。
    resp = build_response(True, data={"stage": 0, "domain": DOMAIN_NAME, "plan": PLAN_FILE.name, "kb": list(KB_FILES), "docs": len(docs), "checks": checks, "models": list(DOMESTIC_MODELS)})  # 构造成功响应，带业务域、两套库与国产模型标识。
    safe_print(json.dumps(resp, ensure_ascii=False, indent=2))  # 打印成功响应，作为自测通过的凭证。


if __name__ == "__main__":  # 仅在脚本被直接运行时执行入口，被导入时不产生副作用。
    main()  # 调用自测入口，开始校验。
```

### ④ 这一阶段最可能出问题的地方

| # | 风险 | 影响 | 处理 |
|---|---|---|---|
| 1 | 四来源未收敛：Brief 与 Industry 为空、publicSources 为空，制度／日志／单据／观察四类核实材料一份未取得 | 97 篇语料容易被误当作已确认需求 | 全部 `status=unverified`、回带证据强度与版本；六条分歧原样保留；不修改规则、不请求配置 |
| 2 | 主模型百炼免费额度有有效期（约 90 天），且不同模型名是否免费口径不一 | 额度到期或选错模型名可能产生费用或调用失败 | 备用 `glm-4-flash` 官方永久免费兜底；到期把 config 主备对调，不改代码；阶段 1 实测模型名与额度 |
| 3 | 第三方对「GLM-4.7-Flash 是否免费」说法冲突，且模型名选错会扣费 | 误把收费模型写进默认配置 | 不写入 config；只列候选，阶段 1 用真实请求核实 |
| 4 | 异常路径的处理时限、验收排班、试剂可用性判定时限未采集 | `NEED_HUMAN_CONFIRM` 链路无法证明能闭环 | 用历史异常单回放验证「暂停建议—采购核对—安全确认」 |
| 5 | 时间／版本／样本四套口径并存，18 天各节点耗时未分别计量 | 瓶颈 A/B 归属与 98% 验收口径无法落地 | 用 20 个常用试剂近 3 个月单据回放校准；局部与整体指标先约定换算 |
| 6 | harness 包名／API 签名与两家国内模型的 OpenAI 兼容端点未实测 | 阶段 2 编排可能跑不通 | 阶段 1 先做最小可跑验证，锁定真实签名与限流行为 |
| 7 | `@scene#54「日常开发」` 原始知识库未单独提供文件 | KB-1 只能用本方案与提示词沉淀的工程规范占位 | 已按工程约束装载 12 篇；如后续提供原文件，覆盖 KB-1 即可，不影响 KB-2 |

---

## 十三、待确认

材料已全部提供，本阶段不再索要任何补充资料、不修改业务规则、不请求配置。只需确认一件事：**是否同意按本方案进入阶段 1**，开始落地 `config.yaml`、`response.py`、`kb.py` 与两家国内模型的最小可跑验证；确认后按同一四项格式交付下一阶段产物。
